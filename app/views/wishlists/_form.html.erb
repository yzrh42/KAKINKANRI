<%= form_with model: wishlist, local: true, class: "space-y-5" do |f| %>
    <%= render 'shared/error_messages', object: f.object %>
    <label class="form-control w-full max-w-xs">
      <div class="label">
        <span class="label-text">名称 ※必須</span>
      </div>
      <%= f.text_field :name, class: "input input-bordered w-full max-w-xs" %>
    </label>
    <label class="form-control w-full max-w-xs">
      <div class="label">
        <span class="label-text">金額 ※必須</span>
      </div>
      <%= f.text_field :price,  placeholder: "円", class: "input input-bordered w-full max-w-xs" %>
    </label>
    
    <%= f.submit "登録", class: 'btn btn-primary'  %>
<% end %>