<%= form_with model: ban, local: true, class: "space-y-5" do |f| %>
    <%= render 'shared/error_messages', object: f.object %>
    <label class="form-control w-full max-w-xs">
      <div class="label">
        <span class="label-text">ゲーム名 ※必須</span>
      </div>
      <%= f.collection_select :game_id, @games, :id, :name, { include_blank: '登録済ゲーム名から選択' }, { class: 'select select-bordered  w-full max-w-xs' } %>
    </label>

    <label class="form-control w-full max-w-xs">
        <div class="label">
            <span class="label-text">ガチャ禁開始日 ※必須</span>
        </div>
        <%= f.date_field :date, class: "input input-bordered w-full max-w-xs" %>
    </label>
    
    <%= f.submit "登録", class: 'btn btn-primary' %>
<% end %>