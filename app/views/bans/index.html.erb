<div class="mx-auto w-11/12 max-w-lg text-center my-10">
    <div class="flex justify-between mb-4">
        <h1 class="mb-4 text-2xl font-bold">ガチャ禁記録一覧</h1>
        <%= link_to "NEW", new_ban_path, class: "btn btn-neutral btn-sm" %>
    </div>
    <div class="overflow-x-auto">
        <table class="table">
            <thead>
                <tr>
                    <th>Game</th> 
                    <th>Start</th>
                    <th>Period</th>
                </tr>
            </thead>
        </table>
        <table class="table">
            <tbody>
                <% @bans.each do |ban| %>
                    <tr>
                        <td><%= ban.game.name %></td>
                        <td><%= ban.start_date %></td>
                        <td><%= link_to '編集', edit_ban_path(ban), class: 'btn btn-accent btn-sm' %></td>
                        <td><%= link_to '削除',
                              ban_path(ban),
                              class: 'btn btn-secondary btn-sm',
                              data: { turbo_method: :delete} %></td>
                        <td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>
</div>